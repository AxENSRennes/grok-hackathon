[Unit]
Description=Sidequest Live multiplayer
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sidequest
Group=sidequest
WorkingDirectory=/srv/sidequest/current
EnvironmentFile=/etc/sidequest/sidequest.env
ExecStart=/usr/bin/node --max-old-space-size=384 dist/server/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=sidequest
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryHigh=512M
MemoryMax=768M
CPUQuota=150%
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
