PORT=2567
# Bind to 127.0.0.1 when a reverse proxy runs on the same host.
# HOST=127.0.0.1
# MAX_ROOMS=5
# Structured JSON logs go to stdout and systemd-journald in production.
# LOG_LEVEL=info
# Sample movement-to-render traces for at most 300 seconds after server startup.
# MOVEMENT_TRACE_SECONDS=0
# Public frontend origin in production; comma-separated if needed.
# ALLOWED_ORIGINS=https://your-domain.example
# Optional public base URL for QR links behind a reverse proxy.
# PUBLIC_URL=https://your-domain.example
# Results are saved locally here; mount a persistent volume in production.
DATA_DIR=./data
# Better Auth: generate a private random secret (at least 32 characters).
# BETTER_AUTH_SECRET=
# Only these pre-provisioned email accounts may create rooms or use host commands.
# HOST_EMAILS=you@example.com
