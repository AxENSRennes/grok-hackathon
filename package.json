{
  "name": "sidequest-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsup --config tsup.config.ts",
    "auth:create-host": "tsx scripts/create-host.ts",
    "start": "node dist/server/index.js",
    "check": "npm run typecheck",
    "test": "npm run test:smoke",
    "test:smoke": "vitest run src/server/physics.test.ts -t 'normalizes diagonals|stops after a controller disappears'",
    "test:unit": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:load": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.23",
    "@colyseus/schema": "^5.0.42",
    "@colyseus/sdk": "^0.18.6",
    "@colyseus/ws-transport": "^0.18.4",
    "better-auth": "^1.7.12",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "phaser": "^3.90.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.15"
  }
}
